{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@workout-tracker/proto": ["./server/proto/src/index.ts"],
      "@workout-tracker/server-limits": ["./server/limits/src/index.ts"],
      "@workout-tracker/types": ["./client/types/src/index.ts"],
      "@workout-tracker/reducer": ["./client/reducer/src/index.ts"],
      "@workout-tracker/utils": ["./client/utils/src/index.ts"],
      "@workout-tracker/limits": ["./client/limits/src/index.ts"],
      "@workout-tracker/client-limits": ["./client/limits/src/index.ts"],
      "@workout-tracker/proto/*": ["./server/proto/src/*"],
      "@workout-tracker/gateway/*": ["./server/gateway/src/*"],
      "@workout-tracker/users-svc/*": ["./server/users-svc/src/*"],
      "@workout-tracker/workouts-svc/*": ["./server/workouts-svc/src/*"],
      "@workout-tracker/reducer/*": ["./client/reducer/src/*"],
      "@workout-tracker/types/*": ["./client/types/src/*"],
      "@workout-tracker/utils/*": ["./client/utils/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
