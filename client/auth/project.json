{
  "name": "auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "client/auth/src",
  "projectType": "application",
  "tags": ["type:app", "scope:client"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "rspack serve --mode=development",
        "cwd": "client/auth",
        "env": { "ZE_DISABLED": "true" }
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["shell:serve"]
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "rspack build --mode=production",
        "cwd": "client/auth",
        "env": { "ZE_DISABLED": "true" }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "rspack build --mode=production",
        "cwd": "client/auth",
        "env": { "ZE_DISABLED": "false" }
      }
    }
  }
}
