{
  "name": "workout-view",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "client/workout-view/src",
  "projectType": "application",
  "tags": ["type:app", "scope:client"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "rspack serve --mode=development",
        "cwd": "client/workout-view"
      },
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["shell:serve", "workout-new:serve"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rspack build --mode=production",
        "cwd": "client/workout-view"
      }
    }
  }
}
