{
  "name": "proto",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "server/proto/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:server"],
  "// targets": "to see all targets run: nx show project proto --web",
  "targets": {
    "codegen": {
      "command": "npx buf generate",
      "options": { "cwd": "server/proto" },
      "inputs": [
        "{projectRoot}/protos/**/*.proto",
        "{projectRoot}/buf.yaml",
        "{projectRoot}/buf.gen.yaml",
        { "externalDependencies": ["ts-proto", "@bufbuild/buf"] }
      ],
      "outputs": ["{projectRoot}/src/generated"],
      "cache": true
    }
  }
}
